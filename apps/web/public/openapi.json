  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "hl_<opaque-token>"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": ["error", "code"]
      },
      "Money": {
        "type": "object",
        "properties": {
          "currency": {
            "enum": [
              "CNY",
              "USD",
              "EUR",
              "GBP",
              "HKD",
              "JPY",
              "SGD",
              "AUD",
              "CAD",
              "CHF",
              "KRW",
              "TWD",
              "THB",
              "NZD"
            ]
          },
          "minor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "rate": {
            "type": "string",
            "description": "人民币折算汇率的十进制字符串。CNY 必须为 1。"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "source": {
            "enum": ["manual", "frankfurter", "legacy"]
          }
        },
        "required": ["currency", "minor", "rate", "date", "source"]
      },
      "Entry": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
          },
          "merchant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accountId": {
            "type": "string"
          },
          "transferToAccountId": {
            "type": ["string", "null"]
          },
          "adjustmentSign": {
            "enum": [1, -1]
          },
          "detail": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "expense",
                  "income",
                  "transfer",
                  "aa_settlement",
                  "refund",
                  "lend",
                  "borrow",
                  "repay_receive",
                  "repay_pay",
                  "reimburse",
                  "fee",
                  "interest",
                  "invest_buy",
                  "invest_sell",
                  "adjust",
                  "excluded"
                ]
              },
              "original": {
                "$ref": "#/components/schemas/Money"
              },
              "destination": {
                "$ref": "#/components/schemas/Money"
              },
              "relatedId": {
                "type": "string"
              },
              "debtId": {
                "type": "string"
              },
              "isReimbursable": {
                "type": "boolean"
              },
              "splits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "memberId": {
                      "type": "string"
                    },
                    "amount": {
                      "type": "integer"
                    }
                  },
                  "required": ["memberId", "amount"]
                }
              },
              "attachmentIds": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["type", "original"]
          }
        },
        "required": ["date", "merchant", "category", "accountId", "detail"]
      },
      "Record": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "merchant": {
            "type": "string"
          },
          "amount": {
            "type": "integer"
          },
          "currency": {
            "const": "CNY"
          },
          "kind": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "detail": {
            "type": "object"
          }
        },
        "required": ["id", "date", "amount", "detail"]
      },
      "Draft": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sourceHash": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "sourceLabel": {
            "type": "string"
          },
          "memberId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "attachmentIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "candidate": {
            "type": "object"
          },
          "state": {
            "enum": ["pending", "confirmed", "discarded"]
          },
          "recordId": {
            "type": "string"
          }
        },
        "required": ["id", "candidate", "state"]
      },
      "AttachmentInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "mime": {
            "enum": ["image/png", "image/jpeg", "image/webp", "image/gif"]
          },
          "base64": {
            "type": "string",
            "contentEncoding": "base64",
            "description": "最多 8 MiB 原始图片。内容必须与 MIME 匹配。"
          }
        },
        "required": ["name", "mime", "base64"]
      },
      "Attachment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "createdAt": {
            "type": "integer"
          },
          "base64": {
            "type": "string",
            "contentEncoding": "base64",
            "description": "下载时返回，上传响应不包含。"
          }
        },
        "required": ["id", "name", "mime", "hash", "createdAt"]
      },
      "WriteResult": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer"
          },
          "operationId": {
            "type": "string"
          },
          "record": {
            "$ref": "#/components/schemas/Record"
          }
        },
        "required": ["revision", "record"]
      }
    }
  }
}
