                "required": ["revision", "draftId", "entry"]
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9:_-]{8,100}$"
            }
          }
        ]
      }
    },
