{
  "openapi": "3.1.0",
  "info": {
    "title": "Hamster Ledger Open API",
    "version": "1.0.0",
    "description": "专用 Bearer 令牌绑定一个联网账本及创建者。每分钟 60 次请求。禁止 Cookie、Origin。写入须 Idempotency-Key；同键同请求重放，同键不同请求 409。模型识别后再次验证权限。"
  },
  "servers": [
    {
      "url": "/api/open/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/ping": {
      "get": {
        "summary": "连通、账本版本和权限",
        "description": "任何有效令牌均可调用。",
        "operationId": "get_ping",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "version": {
                      "const": "v1"
                    },
                    "bookId": {
                      "type": "string"
                    },
                    "revision": {
                      "type": "integer"
                    },
                    "role": {
                      "type": "string"
                    },
                    "scopes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求失败，详见 error/code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "请求失败，详见 error/code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "请求失败，详见 error/code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
